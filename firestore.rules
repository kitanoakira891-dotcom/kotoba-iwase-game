rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    match /rooms/{roomId} {
      function main(){ return roomId == 'MAIN00'; }
      allow get: if signedIn() && main();
      allow list, update, delete: if false;
      allow create: if signedIn() && main() && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      match /members/{memberId} {
        function valid(d){ return d.keys().hasOnly(['uid','name','joinedAt','lastSeenAt','updatedAt']) && d.uid==memberId && d.name is string && d.name.size()>=1 && d.name.size()<=16; }
        allow read: if signedIn() && main();
        allow create: if signedIn() && main() && memberId==request.auth.uid && valid(request.resource.data);
        allow update: if signedIn() && main() && memberId==request.auth.uid && valid(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','lastSeenAt','updatedAt']);
        // 管理者ボタンは画面側の簡易制御。削除処理を成立させるため匿名認証済み利用者に許可。
        allow delete: if signedIn() && main();
      }
      match /words/{wordId} {
        function valid(d){ return d.keys().hasOnly(['text','points','count','totalScore','order','createdAt','updatedAt']) && d.text is string && d.text.size()>=1 && d.text.size()<=40 && d.points is int && d.points>=-999 && d.points<=999 && d.count is int && d.count>=0 && d.totalScore==d.count*d.points; }
        function personal(delta){ let p=/databases/$(database)/documents/rooms/$(roomId)/memberWords/$(request.auth.uid+'_'+wordId); return existsAfter(p) && getAfter(p).data.uid==request.auth.uid && getAfter(p).data.wordId==wordId && (exists(p)?getAfter(p).data.count==get(p).data.count+delta:delta==1&&getAfter(p).data.count==1); }
        allow read: if signedIn() && main();
        allow create: if signedIn() && main() && valid(request.resource.data) && request.resource.data.count==0 && request.resource.data.createdAt==request.time;
        allow delete: if signedIn() && main();
        allow update: if signedIn() && main() && valid(request.resource.data) && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','points','totalScore','updatedAt']) && request.resource.data.count==resource.data.count) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','totalScore','updatedAt']) && (request.resource.data.count==resource.data.count+1 || request.resource.data.count==resource.data.count-1) && request.resource.data.totalScore==resource.data.totalScore+(request.resource.data.count-resource.data.count)*resource.data.points && personal(request.resource.data.count-resource.data.count)));
      }
      match /memberWords/{id} {
        function valid(d){ return d.keys().hasOnly(['uid','wordId','count','updatedAt']) && id==d.uid+'_'+d.wordId && d.count is int && d.count>=0; }
        function word(delta){ let p=/databases/$(database)/documents/rooms/$(roomId)/words/$(request.resource.data.wordId); return getAfter(p).data.count==get(p).data.count+delta && getAfter(p).data.totalScore==get(p).data.totalScore+delta*get(p).data.points; }
        allow read: if signedIn() && main();
        allow create: if signedIn() && main() && request.resource.data.uid==request.auth.uid && valid(request.resource.data) && request.resource.data.count==1 && word(1);
        allow update: if signedIn() && main() && resource.data.uid==request.auth.uid && valid(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','updatedAt']) && (request.resource.data.count==resource.data.count+1 || request.resource.data.count==resource.data.count-1) && word(request.resource.data.count-resource.data.count);
        allow delete: if signedIn() && main();
      }
      match /events/{eventId} {
        function valid(d){ return d.keys().hasOnly(['uid','name','wordId','wordText','delta','points','occurredAt']) && d.uid==request.auth.uid && d.name is string && d.name.size()>=1 && d.name.size()<=16 && d.wordId is string && d.wordText is string && (d.delta==1 || d.delta==-1) && d.points is int && d.occurredAt==request.time; }
        allow read: if signedIn() && main();
        allow create: if signedIn() && main() && valid(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
